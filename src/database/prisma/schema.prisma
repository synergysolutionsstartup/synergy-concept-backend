// SCHEMA.PRISMA FILE
// THE ACTUAL SCHEMAS ARE DEFINED IN THEIR RESPCTIVE FILES IN THE SCHEMA FOLDER.

generator client {
  provider = "prisma-client-js"
  output   = "../client"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

