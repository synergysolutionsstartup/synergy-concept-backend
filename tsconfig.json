{
  "compilerOptions": {
    /* File Layout */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Module System */
    "module": "commonjs",
      "target": "es2020",

    /* Node.js Types */
    "types": ["node"],

    /* Output Options */
    "sourceMap": true,
    "declaration": false,       // no need for .d.ts since this is an app
    "declarationMap": false,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,

    /* Compatibility */
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    /* Path Aliases */
    "baseUrl": "./",
    "paths": {
      "@src/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
